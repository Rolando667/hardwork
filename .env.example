# ==========================================================================
# Self-Regulating Spot Grid Bot — example environment file
# Copy to .env and fill in. NEVER commit your real .env (it is .gitignored).
# All values are loaded server-side only; the browser never sees keys.
# ==========================================================================

# ---- operating mode -------------------------------------------------------
# dry_run  : compute + log every decision, place NOTHING (default, start here)
# testnet  : trade on the exchange sandbox with fake funds
# live     : real funds — requires ALLOW_LIVE=true AND a positive MAX_CAPITAL
MODE=dry_run

# Live is opt-in and capped. The backend refuses to start live without BOTH.
ALLOW_LIVE=false
MAX_CAPITAL=0

# ---- exchange -------------------------------------------------------------
# Any ccxt exchange id (binance default; bybit, okx, kraken, ... also work).
EXCHANGE=binance
SYMBOL=SOL/USDT

# Trade-only API key — NO withdrawal scope. Set an IP allow-list on the
# exchange. Leave blank for dry_run (it uses public market data only).
API_KEY=
API_SECRET=
# Only some exchanges (okx, kucoin) need a passphrase.
API_PASSWORD=

# ---- grid strategy (same params as the calculator) ------------------------
INVEST=1000
GRIDS=20
GRID_MODE=geometric          # geometric | arithmetic
LOWER=0                      # 0 => auto-range around current price on deploy
UPPER=0
FEE_PCT=0.1                  # per-fill fee in percent
SLIP_BPS=2                   # per-fill slippage/spread in basis points
AUTO_RANGE_PCT=0.25          # +/- band used when LOWER/UPPER are auto

# ---- decision engine (no-trade band / hysteresis) ------------------------
CYCLE_SECONDS=300            # re-evaluate every N seconds (60..900 typical)
BAND_PCT=0.5                 # reposition if price leaves range by > this * grid step
VOL_PCT=0.5                  # reposition if ATR% shifts by > this fraction vs set
MIN_FILL_RATE_PER_DAY=1.0    # reposition if fills/day drop below this (idle grid)
FILL_RATE_GRACE_HOURS=6      # don't judge fill-rate until grid is this old
REJECT_OVERFIT=true          # reject candidates that fail out-of-sample validation

# ---- throttle -------------------------------------------------------------
COOLDOWN_SECONDS=3600        # minimum seconds between repositions
MAX_REPOSITIONS_PER_DAY=6

# ---- safety ---------------------------------------------------------------
MAX_DAILY_LOSS=50            # halt + alert if intraday realized+floating <= -this

# ---- klines used for metrics & walk-forward validation --------------------
KLINE_INTERVAL=1h
HISTORY_CANDLES=500

# ---- optional AI advisor (OFF by default) ---------------------------------
# The advisor never trades; it explains, sanity-checks, and may suggest a tiny
# parameter tweak that is clamped and re-validated. Keep it cheap.
USE_AI=false
AI_MODEL=claude-haiku-4-5    # any Claude model id
AI_CADENCE_CYCLES=4          # consult every N cycles
AI_MAX_PARAM_NUDGE_PCT=0.15  # clamp any AI tweak to +/- this fraction
ANTHROPIC_API_KEY=

# ---- server / storage -----------------------------------------------------
HOST=127.0.0.1
PORT=8000
DB_PATH=gridbot.db
